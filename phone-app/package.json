{
  "name": "official-codex-phone-app",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "start:expo-go": "expo start",
    "android": "expo run:android",
    "android:local": "powershell -ExecutionPolicy Bypass -File ./scripts/run-android-local.ps1",
    "android:metro": "expo start --android",
    "prebuild:android": "expo prebuild --platform android",
    "build:android:preview": "npx eas-cli build -p android --profile preview",
    "build:android:development": "npx eas-cli build -p android --profile development",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test:logic": "node ./scripts/run-logic-tests.mjs"
  },
  "dependencies": {
    "expo": "~54.0.34",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.21",
    "expo-image-picker": "~17.0.11",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.23",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "@types/react": "~19.1.10",
    "babel-preset-expo": "~54.0.10",
    "typescript": "~5.9.2",
    "undici-types": "^7.24.2"
  }
}
